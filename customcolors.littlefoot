/*
  customcolors.littlefoot LUMI Key/Piano M script
  by sollapse/2025

  Allows for customizing per-key colors for on and off states and the octave buttons, along with fading between key colors when active.
  Outputs single channel MIDI or MPE (one lower or upper zone).

  Uses portions of the default ROLI LUMI Key script as a guide.
  https://github.com/benob/LUMI-lights/blob/master/littlefoot/LUMI%20Keys%20Block%20Default%20Program.littlefoot
*/

/*
<metadata description="">
    <groups>
    
       <group name="mpe" displayName="MPE" />
       <group name="offColors" displayName="Off Colors" />
       <group name="onColors" displayName="On Colors" />
       <group name="octColors" displayName="Octave Button Colors" />
        
    </groups>
    <variables>
        
            <variable name="midiChan" displayName="MIDI Channel (Single Channel)" type="int" min="1" max="16" value="1" />
            <variable name="polyAT" displayName="Poly Aftertouch (Single Channel)" type="bool" value="true" />
            <variable name="mpeMode" displayName="MPE Mode" type="bool" value="false" />
            <variable name="toggleVel" displayName="Fixed Velocity Toggle" type="bool" value="false" />
            <variable name="fixedVel" displayName="Fixed Velocity" type="int" min="1" max="127" value="93" />
            <variable name="toggleVB" displayName="Velocity Brightness" type="bool" value="false" />
            <variable name="fadeColors" displayName="Fade On/Off Colors" type="bool" value="false" />
            <variable name="fadeInc" displayName="Fade Step" type="int" min="1" max="100" value="10" />
            <variable group="mpe" name="mpeUpperZone" displayName="Upper Zone (Manager Channel 16)" type="bool" value="false" />
            <variable group="mpe" name="mpeMembers" displayName="Member Channels" type="int" min="1" max="15" value="15" />
            <variable group="offColors" name="offBright" displayName="Key Off Brightness" type="int" min="0" max="100" value="100" />
            <variable group="offColors" name="keyOffCol0" displayName="Key 1" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol1" displayName="Key 2" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol2" displayName="Key 3" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol3" displayName="Key 4" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol4" displayName="Key 5" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol5" displayName="Key 6" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol6" displayName="Key 7" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol7" displayName="Key 8" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol8" displayName="Key 9" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol9" displayName="Key 10" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol10" displayName="Key 11" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol11" displayName="Key 12" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol12" displayName="Key 13" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol13" displayName="Key 14" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol14" displayName="Key 15" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol15" displayName="Key 16" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol16" displayName="Key 17" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol17" displayName="Key 18" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol18" displayName="Key 19" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol19" displayName="Key 20" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol20" displayName="Key 21" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol21" displayName="Key 22" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol22" displayName="Key 23" type="colour" value="0xFFFFFF" />
            <variable group="offColors" name="keyOffCol23" displayName="Key 24" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="onBright" displayName="Key On Brightness" type="int" min="0" max="100" value="100" />
            <variable group="onColors" name="keyOnCol0" displayName="Key 1" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol1" displayName="Key 2" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol2" displayName="Key 3" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol3" displayName="Key 4" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol4" displayName="Key 5" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol5" displayName="Key 6" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol6" displayName="Key 7" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol7" displayName="Key 8" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol8" displayName="Key 9" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol9" displayName="Key 10" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol10" displayName="Key 11" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol11" displayName="Key 12" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol12" displayName="Key 13" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol13" displayName="Key 14" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol14" displayName="Key 15" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol15" displayName="Key 16" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol16" displayName="Key 17" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol17" displayName="Key 18" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol18" displayName="Key 19" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol19" displayName="Key 20" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol20" displayName="Key 21" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol21" displayName="Key 22" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol22" displayName="Key 23" type="colour" value="0xFFFFFF" />
            <variable group="onColors" name="keyOnCol23" displayName="Key 24" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol0" displayName="Octave -2" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol1" displayName="Octave -1" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol2" displayName="Octave 0" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol3" displayName="Octave 1" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol4" displayName="Octave 2" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol5" displayName="Octave 3" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol6" displayName="Octave 4" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol7" displayName="Octave 5" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol8" displayName="Octave 6" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol9" displayName="Octave 7" type="colour" value="0xFFFFFF" />
            <variable group="octColors" name="octCol10" displayName="Octave 8" type="colour" value="0xFFFFFF" />
    </variables>
</metadata>
*/

//Globals
const int configItemId_brightness = 36;
const int configItemId_pbrange = 3;

//On and Off Brightness

const int maxKeys = 24;
const int maxOct = 8;
const int minOct = -2;

//Messages a host can send as BLOCKS program events; each id spells its name in ASCII
const int HCOL = 0x48434F4C; //host color mode: p2 = 1 on, 0 off, which puts the saved colors back
const int KCOL = 0x4B434F4C; //key color, in host color mode: p2 = key 0-23 for its off color, 256 + key for its on color; p3 = 0xRRGGBBAA
const int OCOL = 0x4F434F4C; //octave button color, in host color mode: p2 = octave -2 to 8; p3 = 0xRRGGBBAA
const int GOCT = 0x474F4354; //get octave: answered with GOCT, the octave (-2 to 8) and the note key 1 plays

//Host color mode, for other software: the colors a host sends replace Dashboard's, which are read again when it ends
bool hostMode;

//Declare every other array before keyCols: the compiler starts an array declared after a 2D array
//only one row past the 2D array's start, so the two would share memory

//MPE channel allocation: notes held and last use, per channel
int chanNotes[16];
int chanStamp[16];
int stampCount;
int nextChan; //member channel the allocator tries first

//Last pitch bend and channel pressure sent per channel, repeats aren't sent again
int chanBend[16];
int chanPress[16];

//2D array for on and off colors, octave button colors (10), key state, key pitch bend flags, key color fading,
//the lit color (on color with brightness and velocity applied, worked out when the key lights),
//the note (+1, 0 when silent) and channel captured at strike so a lift still matches its note after an octave change,
//the off color with brightness applied (worked out when the lights turn on) and the last poly aftertouch sent
//Column 11 is the key state from the host, kept apart from a finger's (column 3) so neither can darken a key the other still has on
const int keyCols[maxKeys][12];


bool toggleCols;
int curOct;
int cPB; //pitchbend key counter
float tOff, tOn;

//Last applied MIDI settings, compared every frame to pick up Dashboard changes
int lastZone, lastMembers, lastChan, lastBend;
int hostOffFrames; //frames the host has been disconnected, up to 12
int mcmStep; //next zone announcement step, -1 when done

void initialise()
{
    setLocalConfigActiveState (configItemId_brightness, true, true);
    setLocalConfigActiveState (configItemId_pbrange, true, true);
    setLocalConfigActiveState (10, true, true); // strike sensitivity
    setLocalConfigActiveState (13, true, true); // press sensitivity
    setLocalConfigActiveState (14, true, true); // lift sensitivity

    toggleCols = false;
    curOct = 4; //Octave 4;

    lastZone = -1;
    lastMembers = -1;
    lastChan = -1;
    lastBend = -1;
    mcmStep = -1;

    //Unknown until sent, so the first bend and pressure on each channel always go out
    for (int ch = 0; ch < 16; ch++)
    {
        chanBend[ch] = -1;
        chanPress[ch] = -1;
    }
}

void handleButtonDown(int index)
{
    if (index == 0)
    {
        toggleCols = toggleCols ? false : true;

        if (toggleCols)
            cacheCols();
       
    }
    else if (index == 1 || index == 2)
    {
        int oct = index == 2 ? curOct + 1 : curOct - 1;

        if (oct >= minOct && oct <= maxOct)
        {
            curOct = oct;

            //The host's notes land on keys by the octave they arrived under, so once the octave changes their note-offs
            //resolve to other keys and would leave these lit. A key a finger holds stays lit through its own column
            for (int i = 0; i < maxKeys; i++)
                if (keyCols[i][11] > 0)
                    setKeyLit(i, 11, 0);
        }
    }
    
}

int getKey (int note)
{
    int bn = 24 + (curOct * 12);

    if (note < bn || note >= bn + 24)
        return -1;

    return note - bn;
}

int getNote(int key)
{
    int n = (24 + (curOct * 12)) + key;
    
    //Never below 0: octave -2 puts key 1 on note 0
    if (n < 128)
        return n;
    else
        return -1;
}

//On color with brightness and velocity brightness applied
int litCol(int index, int vel)
{
    int c = keyCols[index][0];
    float vB = 1.0;

    if (toggleVB)
        vB = map(float(vel), 0.0, 127.0, 0.0, 1.0);

    return makeARGB(int((((c & 0xFF000000) >> 24) * tOn) * vB), int((((c & 0x00FF0000) >> 16) * tOn) * vB), int((((c & 0x0000FF00) >> 8) * tOn) * vB), int(((c & 0x000000FF) * tOn) * vB));
}

//Off color with brightness applied
int offCol(int index)
{
    int c = keyCols[index][1];

    return makeARGB(int(((c & 0xFF000000) >> 24) * tOff), int(((c & 0x00FF0000) >> 16) * tOff), int(((c & 0x0000FF00) >> 8) * tOff), int((c & 0x000000FF) * tOff));
}

//Colors and brightness are only read while the lights are off, so work out the drawn colors once when they turn on
void cacheCols()
{
    for (int i = 0; i < maxKeys; i++)
        cacheKey(i);
}

//A key's drawn colors: its off color, and its lit color while a finger or the host has it on
void cacheKey(int i)
{
    keyCols[i][9] = offCol(i);

    if (keyCols[i][3])
        keyCols[i][6] = litCol(i, keyCols[i][3]);
    else if (keyCols[i][11])
        keyCols[i][6] = litCol(i, keyCols[i][11]);
}

//Blend two ARGB colors, amount 0-100 is the share of col2
int blendCol(int col1, int col2, int amount)
{
    int result = 0;

    for (int shift = 0; shift < 32; shift += 8)
    {
        int a = (col1 >> shift) & 0xFF;
        int b = (col2 >> shift) & 0xFF;
        result = result | ((a + ((b - a) * amount) / 100) << shift);
    }

    return result;
}

void updateCols()
{
    tOn = map(float(onBright), 0.0, 100.0, 0.0, 1.0);
    tOff = map(float(offBright), 0.0, 100.0, 0.0, 1.0);

    //A host's colors (host color mode) replace these until it turns off
    if (hostMode)
        return;

    //On Colors
    keyCols[0][0] = keyOnCol0;
    keyCols[1][0] = keyOnCol1;
    keyCols[2][0] = keyOnCol2;
    keyCols[3][0] = keyOnCol3;
    keyCols[4][0] = keyOnCol4;
    keyCols[5][0] = keyOnCol5;
    keyCols[6][0] = keyOnCol6;
    keyCols[7][0] = keyOnCol7;
    keyCols[8][0] = keyOnCol8;
    keyCols[9][0] = keyOnCol9;
    keyCols[10][0] = keyOnCol10;
    keyCols[11][0] = keyOnCol11;
    keyCols[12][0] = keyOnCol12;
    keyCols[13][0] = keyOnCol13;
    keyCols[14][0] = keyOnCol14;
    keyCols[15][0] = keyOnCol15;
    keyCols[16][0] = keyOnCol16;
    keyCols[17][0] = keyOnCol17;
    keyCols[18][0] = keyOnCol18;
    keyCols[19][0] = keyOnCol19;
    keyCols[20][0] = keyOnCol20;
    keyCols[21][0] = keyOnCol21;
    keyCols[22][0] = keyOnCol22;
    keyCols[23][0] = keyOnCol23;
    
    //Off Colors
    keyCols[0][1] = keyOffCol0;
    keyCols[1][1] = keyOffCol1;
    keyCols[2][1] = keyOffCol2;
    keyCols[3][1] = keyOffCol3;
    keyCols[4][1] = keyOffCol4;
    keyCols[5][1] = keyOffCol5;
    keyCols[6][1] = keyOffCol6;
    keyCols[7][1] = keyOffCol7;
    keyCols[8][1] = keyOffCol8;
    keyCols[9][1] = keyOffCol9;
    keyCols[10][1] = keyOffCol10;
    keyCols[11][1] = keyOffCol11;
    keyCols[12][1] = keyOffCol12;
    keyCols[13][1] = keyOffCol13;
    keyCols[14][1] = keyOffCol14;
    keyCols[15][1] = keyOffCol15;
    keyCols[16][1] = keyOffCol16;
    keyCols[17][1] = keyOffCol17;
    keyCols[18][1] = keyOffCol18;
    keyCols[19][1] = keyOffCol19;
    keyCols[20][1] = keyOffCol20;
    keyCols[21][1] = keyOffCol21;
    keyCols[22][1] = keyOffCol22;
    keyCols[23][1] = keyOffCol23;
    
    //Octave Buttons Colors;
    keyCols[0][2] = octCol0;
    keyCols[1][2] = octCol1;
    keyCols[2][2] = octCol2; 
    keyCols[3][2] = octCol3;
    keyCols[4][2] = octCol4;
    keyCols[5][2] = octCol5; 
    keyCols[6][2] = octCol6;
    keyCols[7][2] = octCol7;
    keyCols[8][2] = octCol8; 
    keyCols[9][2] = octCol9;
    keyCols[10][2] = octCol10;
}

//A key is lit while a finger (column 3) or the host (column 11) has it on. Each source sets only its own column, so
//the host's note-off can't darken a key a finger still holds, and the lit color follows whichever is still on
void setKeyLit(int index, int column, int vel)
{
    //A note-off for a key that's already dark (e.g. the host echoing a lift) mustn't restart its fade
    bool wasLit = keyCols[index][3] > 0 || keyCols[index][11] > 0;

    keyCols[index][column] = vel;

    if (vel > 0)
        keyCols[index][6] = litCol(index, vel);
    else if (keyCols[index][3] > 0 || keyCols[index][11] > 0)
        cacheKey(index);
    else if (fadeColors && wasLit)
        keyCols[index][5] = 100;
}

//MIDI Handling
const int midiNoteOff         = 0x8;
const int midiNoteOn          = 0x9;

void handleMIDI (int byte0, int byte1, int byte2)
{
    int status = (byte0 >> 4) & 0xf;

    //Only notes light keys, an MPE stream coming back is mostly bend and pressure
    if (status != midiNoteOn && status != midiNoteOff)
        return;

    int key = getKey (byte1);

    //Arrays aren't bounds checked, a -1 row writes into whatever precedes keyCols on the heap
    if (key < 0)
        return;

    if (status == midiNoteOn && byte2 > 0)
        setKeyLit(key, 11, byte2);
    else
        setKeyLit(key, 11, 0);
}

//Host messages. Only GOCT is answered: anything the program sends also reaches the MIDI port as SysEx, which a DAW may record
void handleMessage(int p1, int p2, int p3)
{
    if (p1 == GOCT)
    {
        sendMessageToHost(GOCT, curOct, getNote(0));
    }
    else if (p1 == HCOL)
    {
        //Dashboard's colors are read again when it turns off, and when it turns on, in case no frame has yet
        if (hostMode != (p2 != 0))
        {
            hostMode = false;
            updateCols();
            cacheCols();
            hostMode = p2 != 0;
        }
    }
    else if (hostMode)
    {
        //KCOL and OCOL: p2 is the key or octave, p3 the color. Arrays aren't bounds checked, so only keys 0-23 and
        //octaves -2 to 8 may become rows. 0xRRGGBBAA to ARGB: >> copies the sign bit down when red is 0x80 or more,
        //hence the mask
        int argb = ((p3 & 0xFF) << 24) | ((p3 >> 8) & 0x00FFFFFF);
        int key = p2 & 255;

        if (p1 == KCOL && p2 >= 0 && p2 < 256 + maxKeys && key < maxKeys)
        {
            keyCols[key][p2 < 256 ? 1 : 0] = argb;

            //Keys draw colors worked out ahead, the octave buttons read theirs as they draw
            cacheKey(key);
        }
        else if (p1 == OCOL && p2 >= minOct && p2 <= maxOct)
        {
            keyCols[p2 + 2][2] = argb;
        }
    }
}

//Member channels count inward from the manager channel
int getMemberChan(int i)
{
    return mpeUpperZone ? 14 - i : 1 + i;
}

//Round robin over idle channels: a just-released channel comes round last, so its release tail isn't bent
//by the next note, and the search usually stops at the first channel tried.
//With every channel busy, share the one with the fewest, oldest notes
int allocChannel()
{
    //Where the zone's member channels start, and which way they count
    int first = mpeUpperZone ? 14 : 1;
    int step = mpeUpperZone ? -1 : 1;

    for (int n = 0; n < mpeMembers; n++)
    {
        int i = (nextChan + n) % mpeMembers;
        int ch = first + step * i;

        if (chanNotes[ch] == 0)
        {
            nextChan = i + 1;
            return ch;
        }
    }

    int best = -1;
    int c = first;

    for (int j = 0; j < mpeMembers; j++)
    {
        if (best < 0 || chanNotes[c] < chanNotes[best] || (chanNotes[c] == chanNotes[best] && chanStamp[c] < chanStamp[best]))
            best = c;

        c += step;
    }

    return best;
}

void sendBend(int ch, int value)
{
    if (chanBend[ch] != value)
    {
        chanBend[ch] = value;
        sendPitchBend(ch, value);
    }
}

void sendPressure(int ch, int value)
{
    if (chanPress[ch] != value)
    {
        chanPress[ch] = value;
        sendChannelPressure(ch, value);
    }
}

void sendRPN(int ch, int param, int value)
{
    sendCC(ch, 101, 0);
    sendCC(ch, 100, param);
    sendCC(ch, 6, value);

    if (param == 0)
        sendCC(ch, 38, 0); //bend range cents

    //Deselect, so a later data entry message can't change it
    sendCC(ch, 101, 127);
    sendCC(ch, 100, 127);
}

void startNote(int index, int vel)
{
    int note = getNote (index);

    if (note < 0)
        return;

    int ch = midiChan - 1;

    if (mpeMode)
    {
        ch = allocChannel();

        //Clear the bend and pressure the channel's previous note left behind
        sendBend(ch, 8192);
        sendPressure(ch, 0);
    }

    chanNotes[ch] = chanNotes[ch] + 1;
    stampCount++;
    chanStamp[ch] = stampCount;

    keyCols[index][7] = note + 1;
    keyCols[index][8] = ch;
    keyCols[index][10] = -1;

    sendNoteOn(ch, note, vel);
}

void stopNote(int index, int vel)
{
    if (keyCols[index][7] == 0)
        return;

    int ch = keyCols[index][8];

    sendNoteOff(ch, keyCols[index][7] - 1, vel);
    keyCols[index][7] = 0;

    if (chanNotes[ch] > 0)
        chanNotes[ch] = chanNotes[ch] - 1;

    stampCount++;
    chanStamp[ch] = stampCount;
}

void checkMidiConfig()
{
    //0 = single channel, 1 = MPE lower zone, 2 = MPE upper zone
    int zone = mpeMode ? (mpeUpperZone ? 2 : 1) : 0;
    int bend = getLocalConfig(configItemId_pbrange);

    //Notes started under the old settings would otherwise hang or land on the wrong channels
    if (zone != lastZone || mpeMembers != lastMembers || midiChan != lastChan)
    {
        for (int i = 0; i < maxKeys; i++)
        {
            if (keyCols[i][7])
            {
                stopNote(i, 0);
                sendBend(keyCols[i][8], 8192);
            }

            keyCols[i][4] = false;
        }

        cPB = 0;

        //0 member channels tells the receiver the old zone is gone
        if (lastZone > 0 && zone != lastZone)
            sendRPN(lastZone == 2 ? 15 : 0, 6, 0);

        lastZone = zone;
        lastMembers = mpeMembers;
        lastChan = midiChan;
        nextChan = 0;
        mcmStep = 0;
    }

    //Announce again when the bend range changes
    if (bend != lastBend)
        mcmStep = 0;

    lastBend = bend;

    //...or when a host connects, ignoring dropouts under half a second so a flickering link can't restart it every frame
    if (!isConnectedToHost())
    {
        if (hostOffFrames < 12)
            hostOffFrames++;
    }
    else
    {
        if (hostOffFrames >= 12)
            mcmStep = 0;

        hostOffFrames = 0;
    }

    if (zone == 0)
        mcmStep = -1;
    else if (mcmStep >= 0)
    {
        //One step per frame (~25 Hz) so announcing all member channels doesn't flood the MIDI link.
        //The MPE Configuration Message resets member bend ranges to 48, so it goes first
        if (mcmStep == 0)
            sendRPN(mpeUpperZone ? 15 : 0, 6, mpeMembers);
        else
            sendRPN(getMemberChan(mcmStep - 1), 0, bend);

        mcmStep++;

        if (mcmStep > mpeMembers)
            mcmStep = -1;
    }
}


void keyStrike(int index, int u, int vel)
{
    if (toggleVel) vel = fixedVel;

    setKeyLit(index, 3, vel);

    stopNote(index, 0);
    startNote(index, vel);
}

void keyPress(int index, int at, int vel)
{
    if (keyCols[index][7] == 0)
        return;

    //MPE pressure is per note by way of its own channel
    if(polyAT && !mpeMode)
    {
        if (keyCols[index][10] != at)
        {
            keyCols[index][10] = at;
            sendAftertouch (keyCols[index][8], keyCols[index][7] - 1, at);
        }
    }
    else
        sendPressure(keyCols[index][8], at);

}

void keyMove (int index, int pb, int at)
{
    if (keyCols[index][7] == 0)
        return;

    if(!keyCols[index][4]){keyCols[index][4] = true; cPB++;}

    sendBend(keyCols[index][8], pb);
} 	

void keyLift(int index, int u, int vel)
{
    setKeyLit(index, 3, 0);
    if(keyCols[index][4]){keyCols[index][4] = false; cPB--;}

    stopNote(index, vel);

    //Single channel: reset PitchBend if counter is zero
    //MPE: leave it so the release tail keeps its pitch, the channel's next note clears it
    if (!mpeMode && cPB == 0)
        sendBend(midiChan - 1, 8192);
}

void renderOctaveBtns()
{
    int c = keyCols[curOct + 2][2];

    fillPixel (curOct > minOct ? c : 0, 0, 1);
    fillPixel (curOct < maxOct ? c : 0, 1, 1);
}

//Draws the colors worked out when keys light and the lights turn on; only keys that are fading blend
void renderKeys()
{
    for (int i = 0; i < maxKeys; i++)
    {
        if (keyCols[i][3] || keyCols[i][11])
        {
            fillPixel(keyCols[i][6], i, 0);
        }
        else if (keyCols[i][5] > 0)
        {
            fillPixel(blendCol(keyCols[i][9], keyCols[i][6], keyCols[i][5]), i, 0);
            keyCols[i][5] = keyCols[i][5] - fadeInc;
        }
        else
        {
            fillPixel(keyCols[i][9], i, 0);
        }
    }
}
	
void repaint()
{
    checkMidiConfig();
    
    if(toggleCols){
        
        //Render key colors
        renderKeys();
        
        //Render Octave Buttons
        renderOctaveBtns();
    }
    else{
        clearDisplay();
        updateCols();
    }

}
