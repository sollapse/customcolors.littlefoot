/*
  customcolors.littlefoot LUMI Key/Piano M script, web editor build
  by sollapse/2025

  Allows for customizing per-key colors for on and off states and the octave buttons, along with fading between key colors when active.
  Keys can follow pitch bend and pressure in color instead, from a finger's touch or from incoming MIDI.
  Outputs single channel MIDI or MPE (one lower or upper zone).

  The settings come from the web editor (editor.html) instead of Dashboard: each 0x5A5A00nn literal is a placeholder
  the editor overwrites before uploading the program. While connected, the editor previews changes through the
  program's shared memory, which the keyboard doesn't keep after a restart.

  Uses portions of the default ROLI LUMI Key script as a guide.
  https://github.com/benob/LUMI-lights/blob/master/littlefoot/LUMI%20Keys%20Block%20Default%20Program.littlefoot
*/

//Shared memory holds the editor's values as 4-byte ints, value n at offset n * 4: 0-23 on colors, 24-47 off colors,
//48-58 octave button colors, then the settings in the order loadBaked() sets them, the pitch bend and pressure colors
#heapsize: 320

//Globals
const int configItemId_brightness = 36;
const int configItemId_pbrange = 3;

const int maxKeys = 24;
const int maxOct = 8;
const int minOct = -2;
const int valueCount = 80;

//Build id, written by lfgen, so the editor only previews through shared memory laid out the way it expects
const int buildId = 0x5A5A00FF;

//Messages from the editor; replies use the same ids
const int msgInfo = 0x43430001;   //reply: build id, flags (768 = message format 3, +1 values other than the program's (a preview or host colors), +2 lights on)
const int msgReport = 0x43430002; //reply: msgValues + n with values n and n + 1 for every even n, then msgReport, value count, value sum
const int msgApply = 0x43430003;  //load the values from shared memory, p2 = 1 also turns the lights on; reply: value sum
const int msgRevert = 0x43430004; //load the values written into the program; reply: value sum
const int msgValues = 0x43430100;

//Messages any host can send; each id spells its name in ASCII
const int HCOL = 0x48434F4C; //host color mode: p2 = 1 on, 0 off, which puts the saved colors back
const int KCOL = 0x4B434F4C; //key color, in host color mode: p2 = key 0-23 for its off color, 256 + key for its on color; p3 = 0xRRGGBBAA
const int OCOL = 0x4F434F4C; //octave button color, in host color mode: p2 = octave -2 to 8; p3 = 0xRRGGBBAA
const int BCOL = 0x42434F4C; //pitch bend color, in host color mode: p2 = 0 down, 1 up; p3 = 0xRRGGBBAA
const int PCOL = 0x50434F4C; //pressure color, in host color mode: p2 = 0 full; p3 = 0xRRGGBBAA
const int GOCT = 0x474F4354; //get octave: answered with GOCT, the octave (-2 to 8) and the note key 1 plays

//Host color mode, for other software: the colors a host sends replace the loaded ones, which load again when it ends
bool hostMode;

//Settings (the switches are 0 or 1)
int midiChan, polyAT, mpeMode, toggleVel, fixedVel, toggleVB, fadeColors, fadeInc;
int mpeUpperZone, mpeMembers, offBright, onBright;

//The keyboard's own settings, which Dashboard lists with the script's and keeps in its presets
int pitchBendRange, strikeSensitivity, pressureSensitivity, liftSensitivity, brightness;

//What keys' colors follow, held or lit by the host: 0 nothing, 1 pitch bend, 2 pressure, 3 both
int bendPressColors;

//Declare every other array before keyCols: the compiler starts an array declared after a 2D array
//only one row past the 2D array's start, so the two would share memory

//MPE channel allocation: notes held and last use, per channel
int chanNotes[16];
int chanStamp[16];
int stampCount;
int nextChan; //member channel the allocator tries first

//Last pitch bend and channel pressure sent per channel, repeats aren't sent again
int chanBend[16];
int chanPress[16];

//Pitch bend colors down and up, then the full pressure color; keys start from their on colors
int bendPressCol[3];

//2D array for on and off colors, octave button colors (11), key state, the key's latest pitch bend (+1, 0 until it
//moves), key color fading, the lit color (worked out when the key lights, and as it bends or its pressure changes),
//the note (+1, 0 when silent) and channel captured at strike so a lift still matches its note after an octave change,
//the off color with brightness applied (worked out when values load) and the key's latest pressure (-1 until pressed)
//Column 11 is the key state from the host, kept apart from a finger's (column 3) so neither can darken a key the other still has on
const int keyCols[maxKeys][12];


bool toggleCols;
int curOct;
int cPB; //pitchbend key counter
float tOff, tOn;

//Last applied MIDI settings, compared every frame to pick up changes
int lastZone, lastMembers, lastChan, lastBend;
int hostOffFrames; //frames the host has been disconnected, up to 12
int mcmStep; //next zone announcement step, -1 when done

bool heapValues; //values came from shared memory rather than the program
int reportStep; //next value the report sends, -1 when not reporting

void initialise()
{
    setLocalConfigActiveState (configItemId_brightness, true, true);
    setLocalConfigActiveState (configItemId_pbrange, true, true);
    setLocalConfigActiveState (10, true, true); // strike sensitivity
    setLocalConfigActiveState (13, true, true); // press sensitivity
    setLocalConfigActiveState (14, true, true); // lift sensitivity

    toggleCols = false;
    curOct = 4; //Octave 4;

    lastZone = -1;
    lastMembers = -1;
    lastChan = -1;
    lastBend = -1;
    mcmStep = -1;
    reportStep = -1;

    //Unknown until sent, so the first bend and pressure on each channel always go out
    for (int ch = 0; ch < 16; ch++)
    {
        chanBend[ch] = -1;
        chanPress[ch] = -1;
    }

    loadValues();
}

void handleButtonDown(int index)
{
    if (index == 0)
    {
        toggleCols = toggleCols ? false : true;
    }
    else if (index == 1 || index == 2)
    {
        int oct = index == 2 ? curOct + 1 : curOct - 1;

        if (oct >= minOct && oct <= maxOct)
        {
            curOct = oct;

            //The host's notes land on keys by the octave they arrived under, so once the octave changes their note-offs
            //resolve to other keys and would leave these lit. A key a finger holds stays lit through its own column
            for (int i = 0; i < maxKeys; i++)
                if (keyCols[i][11] > 0)
                    setKeyLit(i, 11, 0);
        }
    }

}

int getKey (int note)
{
    int bn = 24 + (curOct * 12);

    if (note < bn || note >= bn + 24)
        return -1;

    return note - bn;
}

int getNote(int key)
{
    int n = (24 + (curOct * 12)) + key;

    //Never below 0: octave -2 puts key 1 on note 0
    if (n < 128)
        return n;
    else
        return -1;
}

//Key i's lit color at a velocity, brightness settings applied: pressure (bendPressColors 2) mixes its on color toward
//the full pressure color, then a pitch bend (1) moves that toward the down or up color, all the way at full bend.
//pb is the bend + 1, 0 for none; at is the pressure, -1 before any, which mixes in nothing. With the setting off, the
//on color
int bendPressLit(int i, int pb, int at, int vel)
{
    int c = keyCols[i][0];

    if (bendPressColors & 2)
        c = blendCol(c, bendPressCol[2], at * 100 / 127);

    if ((bendPressColors & 1) && pb > 0)
    {
        int d = pb - 8193;
        c = blendCol(c, d < 0 ? bendPressCol[0] : bendPressCol[1], abs(d) * 100 / 8192);
    }

    return onScaled(c, vel);
}

//A lit color: the on brightness applied, and velocity brightness if it's on
int onScaled(int c, int vel)
{
    float vB = 1.0;

    if (toggleVB != 0)
        vB = map(float(vel), 0.0, 127.0, 0.0, 1.0);

    return makeARGB(int((((c & 0xFF000000) >> 24) * tOn) * vB), int((((c & 0x00FF0000) >> 16) * tOn) * vB), int((((c & 0x0000FF00) >> 8) * tOn) * vB), int(((c & 0x000000FF) * tOn) * vB));
}

//Off color with brightness applied
int offCol(int index)
{
    int c = keyCols[index][1];

    return makeARGB(int(((c & 0xFF000000) >> 24) * tOff), int(((c & 0x00FF0000) >> 16) * tOff), int(((c & 0x0000FF00) >> 8) * tOff), int((c & 0x000000FF) * tOff));
}

//Colors and brightness only change when values load, so work out the drawn colors then
void cacheCols()
{
    for (int i = 0; i < maxKeys; i++)
        cacheKey(i);
}

//A key's drawn colors: its off color, and its lit color while a finger or the host has it on
void cacheKey(int i)
{
    keyCols[i][9] = offCol(i);
    cacheLit(i);
}

//A lit key's color, from the finger holding it, or else from the host's note: column 11 packs its velocity (bits 0-6),
//channel (7-10), pressure (11-17) and bend / 2 (18-30). Tells whether the key is lit
bool cacheLit(int i)
{
    int v = keyCols[i][3];
    int h = keyCols[i][11];

    if (v)
        keyCols[i][6] = bendPressLit(i, keyCols[i][4], keyCols[i][10], v);
    else if (h)
        keyCols[i][6] = bendPressLit(i, ((h >> 18) << 1) + 1, (h >> 11) & 127, h & 127);

    return v || h;
}

//Blend two ARGB colors, amount 0-100 is the share of col2
int blendCol(int col1, int col2, int amount)
{
    int result = 0;

    for (int shift = 0; shift < 32; shift += 8)
    {
        int a = (col1 >> shift) & 0xFF;
        int b = (col2 >> shift) & 0xFF;
        result = result | ((a + ((b - a) * amount) / 100) << shift);
    }

    return result;
}

//Values written into the program by the editor: value n is placeholder 0x5A5A0000 + n
void loadBaked()
{
    //On Colors
    keyCols[0][0] = 0x5A5A0000;
    keyCols[1][0] = 0x5A5A0001;
    keyCols[2][0] = 0x5A5A0002;
    keyCols[3][0] = 0x5A5A0003;
    keyCols[4][0] = 0x5A5A0004;
    keyCols[5][0] = 0x5A5A0005;
    keyCols[6][0] = 0x5A5A0006;
    keyCols[7][0] = 0x5A5A0007;
    keyCols[8][0] = 0x5A5A0008;
    keyCols[9][0] = 0x5A5A0009;
    keyCols[10][0] = 0x5A5A000A;
    keyCols[11][0] = 0x5A5A000B;
    keyCols[12][0] = 0x5A5A000C;
    keyCols[13][0] = 0x5A5A000D;
    keyCols[14][0] = 0x5A5A000E;
    keyCols[15][0] = 0x5A5A000F;
    keyCols[16][0] = 0x5A5A0010;
    keyCols[17][0] = 0x5A5A0011;
    keyCols[18][0] = 0x5A5A0012;
    keyCols[19][0] = 0x5A5A0013;
    keyCols[20][0] = 0x5A5A0014;
    keyCols[21][0] = 0x5A5A0015;
    keyCols[22][0] = 0x5A5A0016;
    keyCols[23][0] = 0x5A5A0017;

    //Off Colors
    keyCols[0][1] = 0x5A5A0018;
    keyCols[1][1] = 0x5A5A0019;
    keyCols[2][1] = 0x5A5A001A;
    keyCols[3][1] = 0x5A5A001B;
    keyCols[4][1] = 0x5A5A001C;
    keyCols[5][1] = 0x5A5A001D;
    keyCols[6][1] = 0x5A5A001E;
    keyCols[7][1] = 0x5A5A001F;
    keyCols[8][1] = 0x5A5A0020;
    keyCols[9][1] = 0x5A5A0021;
    keyCols[10][1] = 0x5A5A0022;
    keyCols[11][1] = 0x5A5A0023;
    keyCols[12][1] = 0x5A5A0024;
    keyCols[13][1] = 0x5A5A0025;
    keyCols[14][1] = 0x5A5A0026;
    keyCols[15][1] = 0x5A5A0027;
    keyCols[16][1] = 0x5A5A0028;
    keyCols[17][1] = 0x5A5A0029;
    keyCols[18][1] = 0x5A5A002A;
    keyCols[19][1] = 0x5A5A002B;
    keyCols[20][1] = 0x5A5A002C;
    keyCols[21][1] = 0x5A5A002D;
    keyCols[22][1] = 0x5A5A002E;
    keyCols[23][1] = 0x5A5A002F;

    //Octave Buttons Colors
    keyCols[0][2] = 0x5A5A0030;
    keyCols[1][2] = 0x5A5A0031;
    keyCols[2][2] = 0x5A5A0032;
    keyCols[3][2] = 0x5A5A0033;
    keyCols[4][2] = 0x5A5A0034;
    keyCols[5][2] = 0x5A5A0035;
    keyCols[6][2] = 0x5A5A0036;
    keyCols[7][2] = 0x5A5A0037;
    keyCols[8][2] = 0x5A5A0038;
    keyCols[9][2] = 0x5A5A0039;
    keyCols[10][2] = 0x5A5A003A;

    onBright = 0x5A5A003B;
    offBright = 0x5A5A003C;
    midiChan = 0x5A5A003D;
    polyAT = 0x5A5A003E;
    mpeMode = 0x5A5A003F;
    mpeUpperZone = 0x5A5A0040;
    mpeMembers = 0x5A5A0041;
    toggleVel = 0x5A5A0042;
    fixedVel = 0x5A5A0043;
    toggleVB = 0x5A5A0044;
    fadeColors = 0x5A5A0045;
    fadeInc = 0x5A5A0046;

    pitchBendRange = 0x5A5A0047;
    strikeSensitivity = 0x5A5A0048;
    pressureSensitivity = 0x5A5A0049;
    liftSensitivity = 0x5A5A004A;
    brightness = 0x5A5A004B;

    bendPressColors = 0x5A5A004C;
    bendPressCol[0] = 0x5A5A004D;
    bendPressCol[1] = 0x5A5A004E;
    bendPressCol[2] = 0x5A5A004F;
}

//Values the editor wrote to shared memory, same order
void loadHeap()
{
    for (int i = 0; i < maxKeys; i++)
    {
        keyCols[i][0] = getHeapInt(i * 4);
        keyCols[i][1] = getHeapInt(96 + i * 4);
    }

    for (int j = 0; j < 11; j++)
        keyCols[j][2] = getHeapInt(192 + j * 4);

    onBright = getHeapInt(236);
    offBright = getHeapInt(240);
    midiChan = getHeapInt(244);
    polyAT = getHeapInt(248);
    mpeMode = getHeapInt(252);
    mpeUpperZone = getHeapInt(256);
    mpeMembers = getHeapInt(260);
    toggleVel = getHeapInt(264);
    fixedVel = getHeapInt(268);
    toggleVB = getHeapInt(272);
    fadeColors = getHeapInt(276);
    fadeInc = getHeapInt(280);

    pitchBendRange = getHeapInt(284);
    strikeSensitivity = getHeapInt(288);
    pressureSensitivity = getHeapInt(292);
    liftSensitivity = getHeapInt(296);
    brightness = getHeapInt(300);

    bendPressColors = getHeapInt(304);

    for (int k = 0; k < 3; k++)
        bendPressCol[k] = getHeapInt(308 + k * 4);
}

//The values from shared memory while a preview shows, else the ones written into the program
void loadValues()
{
    if (heapValues)
        loadHeap();
    else
        loadBaked();

    applyValues();
}

//Keeps the settings note handling divides by or sends in range, writes the keyboard's own settings,
//then works out the colors drawn
void applyValues()
{
    midiChan = clamp(1, 16, midiChan);
    mpeMembers = clamp(1, 15, mpeMembers);
    fixedVel = clamp(1, 127, fixedVel);
    fadeInc = clamp(1, 100, fadeInc);
    onBright = clamp(0, 100, onBright);
    offBright = clamp(0, 100, offBright);

    //Ranges from ROLI's config table
    pitchBendRange = clamp(1, 96, pitchBendRange);
    strikeSensitivity = clamp(0, 127, strikeSensitivity);
    pressureSensitivity = clamp(0, 127, pressureSensitivity);
    liftSensitivity = clamp(0, 127, liftSensitivity);
    brightness = clamp(0, 100, brightness);
    bendPressColors = clamp(0, 3, bendPressColors);

    applyConfig(configItemId_pbrange, pitchBendRange);
    applyConfig(10, strikeSensitivity); // strike sensitivity
    applyConfig(13, pressureSensitivity); // press sensitivity
    applyConfig(14, liftSensitivity); // lift sensitivity
    applyConfig(configItemId_brightness, brightness);

    tOn = map(float(onBright), 0.0, 100.0, 0.0, 1.0);
    tOff = map(float(offBright), 0.0, 100.0, 0.0, 1.0);

    cacheCols();
}

//Written only when it differs, since the keyboard may save its settings to flash
void applyConfig(int item, int value)
{
    if (getLocalConfig(item) != value)
        setLocalConfig(item, value);
}

int getValue(int n)
{
    if (n < 24)
        return keyCols[n][0];

    if (n < 48)
        return keyCols[n - 24][1];

    if (n < 59)
        return keyCols[n - 48][2];

    if (n > 76)
        return bendPressCol[n - 77];

    if (n == 59) return onBright;
    if (n == 60) return offBright;
    if (n == 61) return midiChan;
    if (n == 62) return polyAT;
    if (n == 63) return mpeMode;
    if (n == 64) return mpeUpperZone;
    if (n == 65) return mpeMembers;
    if (n == 66) return toggleVel;
    if (n == 67) return fixedVel;
    if (n == 68) return toggleVB;
    if (n == 69) return fadeColors;
    if (n == 70) return fadeInc;
    if (n == 71) return pitchBendRange;
    if (n == 72) return strikeSensitivity;
    if (n == 73) return pressureSensitivity;
    if (n == 74) return liftSensitivity;
    if (n == 75) return brightness;
    if (n == 76) return bendPressColors;

    return 0;
}

//Wrapping sum of all values, so the editor can tell the program holds what it sent
int valueSum()
{
    int sum = onBright + offBright + midiChan + polyAT + mpeMode + mpeUpperZone + mpeMembers + toggleVel + fixedVel + toggleVB + fadeColors + fadeInc;
    sum = sum + pitchBendRange + strikeSensitivity + pressureSensitivity + liftSensitivity + brightness;
    sum = sum + bendPressColors + bendPressCol[0] + bendPressCol[1] + bendPressCol[2];

    for (int i = 0; i < maxKeys; i++)
        sum = sum + keyCols[i][0] + keyCols[i][1];

    for (int j = 0; j < 11; j++)
        sum = sum + keyCols[j][2];

    return sum;
}

//Spread over frames: how many messages the keyboard can send at once isn't documented
void sendReport()
{
    for (int k = 0; k < 4; k++)
    {
        if (reportStep >= valueCount)
        {
            sendMessageToHost(msgReport, valueCount, valueSum());
            reportStep = -1;
            return;
        }

        sendMessageToHost(msgValues + reportStep, getValue(reportStep), getValue(reportStep + 1));
        reportStep += 2;
    }
}

//Messages come from the editor, and the host color messages from any host. The program only sends messages to
//answer the editor and GOCT: every message also reaches the MIDI port as SysEx, which a DAW may record
void handleMessage(int p1, int p2, int p3)
{
    if (p1 == msgInfo)
    {
        int flags = 768;

        if (heapValues || hostMode)
            flags += 1;

        if (toggleCols)
            flags += 2;

        sendMessageToHost(msgInfo, buildId, flags);
    }
    else if (p1 == msgReport)
    {
        reportStep = 0;
    }
    else if (p1 == msgApply || p1 == msgRevert)
    {
        //The editor's values replace any colors a host sent
        heapValues = p1 == msgApply;
        hostMode = false;
        loadValues();

        if (heapValues && p2 == 1)
            toggleCols = true;

        sendMessageToHost(p1, valueSum(), 0);
    }
    else if (p1 == GOCT)
    {
        sendMessageToHost(GOCT, curOct, getNote(0));
    }
    else if (p1 == HCOL)
    {
        //Turning it off loads the colors again
        if (hostMode && p2 == 0)
            loadValues();

        hostMode = p2 != 0;
    }
    else if (hostMode)
    {
        //KCOL, OCOL, BCOL and PCOL: p2 picks the key, octave or color, p3 is the color. Arrays aren't bounds checked, so
        //only keys 0-23, octaves -2 to 8 and the colors each has may become indexes. 0xRRGGBBAA to ARGB: >> copies the
        //sign bit down when red is 0x80 or more, hence the mask
        int argb = ((p3 & 0xFF) << 24) | ((p3 >> 8) & 0x00FFFFFF);
        int key = p2 & 255;

        if (p1 == KCOL && p2 >= 0 && p2 < 256 + maxKeys && key < maxKeys)
        {
            keyCols[key][p2 < 256 ? 1 : 0] = argb;

            //Keys draw colors worked out ahead, the octave buttons read theirs as they draw
            cacheKey(key);
        }
        else if (p1 == OCOL && p2 >= minOct && p2 <= maxOct)
        {
            keyCols[p2 + 2][2] = argb;
        }
        else if ((p1 == BCOL && p2 >= 0 && p2 < 2) || (p1 == PCOL && p2 == 0))
        {
            //Keys held now take the new color at once
            bendPressCol[p1 == BCOL ? p2 : 2] = argb;
            cacheCols();
        }
    }
}

//A key is lit while a finger (column 3) or the host (column 11) has it on. Each source sets only its own column, so
//the host's note-off can't darken a key a finger still holds, and the lit color follows whichever is still on
void setKeyLit(int index, int column, int vel)
{
    //A note-off for a key that's already dark (e.g. the host echoing a lift) mustn't restart its fade
    bool wasLit = keyCols[index][3] || keyCols[index][11];

    keyCols[index][column] = vel;

    //With the setting off, the latest note-on's velocity sets the color, even a host's on a key a finger holds
    if (vel && !bendPressColors)
        keyCols[index][6] = bendPressLit(index, 0, 0, vel & 127);
    else if (!cacheLit(index) && fadeColors != 0 && wasLit)
        keyCols[index][5] = 100;
}

//MIDI Handling
const int midiNoteOff         = 0x8;
const int midiNoteOn          = 0x9;

void handleMIDI (int byte0, int byte1, int byte2)
{
    int status = (byte0 >> 4) & 0xf;
    int ch = (byte0 & 0xf) << 7;
    int key;

    //Notes light keys; a host note keeps its channel beside its velocity, no pressure and the bend centered. Arrays
    //aren't bounds checked, a -1 row writes into whatever precedes keyCols on the heap
    if (status == midiNoteOn || status == midiNoteOff)
    {
        key = getKey (byte1);

        if (key >= 0)
            setKeyLit(key, 11, status == midiNoteOn && byte2 ? byte2 | ch | 0x40000000 : 0);

        return;
    }

    //While keys follow them, pitch bend, channel pressure and poly aftertouch color the keys the host lit on the same
    //channel, whatever the MIDI mode. Otherwise they cost next to nothing: an MPE stream coming back is mostly these
    if (!bendPressColors)
        return;

    //The column 11 bits the message leaves, and its value for the others: pressure, unless it's a bend
    int keep = 0x7FFC07FF;
    int set = byte1 << 11;
    key = getKey (byte1);

    if (status == 0xE)
    {
        keep = 0x3FFFF;
        set = (((byte2 << 7) | byte1) >> 1) << 18;
    }
    else if (status == 0xA)
        set = byte2 << 11;
    else if (status != 0xD)
        return;

    for (int i = 0; i < maxKeys; i++)
    {
        int h = keyCols[i][11];

        //Nested, as && evaluates both sides and most keys are dark
        if (h)
            if ((h & 0x780) == ch && (status != 0xA || i == key))
            {
                keyCols[i][11] = (h & keep) | set;

                //A key a finger holds keeps following the finger
                if (!keyCols[i][3])
                    cacheLit(i);
            }
    }
}

//Member channels count inward from the manager channel
int getMemberChan(int i)
{
    return mpeUpperZone != 0 ? 14 - i : 1 + i;
}

//Round robin over idle channels: a just-released channel comes round last, so its release tail isn't bent
//by the next note, and the search usually stops at the first channel tried.
//With every channel busy, share the one with the fewest, oldest notes
int allocChannel()
{
    //Where the zone's member channels start, and which way they count
    int first = mpeUpperZone != 0 ? 14 : 1;
    int step = mpeUpperZone != 0 ? -1 : 1;

    for (int n = 0; n < mpeMembers; n++)
    {
        int i = (nextChan + n) % mpeMembers;
        int ch = first + step * i;

        if (chanNotes[ch] == 0)
        {
            nextChan = i + 1;
            return ch;
        }
    }

    int best = -1;
    int c = first;

    for (int j = 0; j < mpeMembers; j++)
    {
        if (best < 0 || chanNotes[c] < chanNotes[best] || (chanNotes[c] == chanNotes[best] && chanStamp[c] < chanStamp[best]))
            best = c;

        c += step;
    }

    return best;
}

void sendBend(int ch, int value)
{
    if (chanBend[ch] != value)
    {
        chanBend[ch] = value;
        sendPitchBend(ch, value);
    }
}

void sendPressure(int ch, int value)
{
    if (chanPress[ch] != value)
    {
        chanPress[ch] = value;
        sendChannelPressure(ch, value);
    }
}

void sendRPN(int ch, int param, int value)
{
    sendCC(ch, 101, 0);
    sendCC(ch, 100, param);
    sendCC(ch, 6, value);

    if (param == 0)
        sendCC(ch, 38, 0); //bend range cents

    //Deselect, so a later data entry message can't change it
    sendCC(ch, 101, 127);
    sendCC(ch, 100, 127);
}

void startNote(int index, int vel)
{
    int note = getNote (index);

    if (note < 0)
        return;

    int ch = midiChan - 1;

    if (mpeMode != 0)
    {
        ch = allocChannel();

        //Clear the bend and pressure the channel's previous note left behind
        sendBend(ch, 8192);
        sendPressure(ch, 0);
    }

    chanNotes[ch] = chanNotes[ch] + 1;
    stampCount++;
    chanStamp[ch] = stampCount;

    keyCols[index][7] = note + 1;
    keyCols[index][8] = ch;

    sendNoteOn(ch, note, vel);
}

void stopNote(int index, int vel)
{
    if (keyCols[index][7] == 0)
        return;

    int ch = keyCols[index][8];

    sendNoteOff(ch, keyCols[index][7] - 1, vel);
    keyCols[index][7] = 0;

    if (chanNotes[ch] > 0)
        chanNotes[ch] = chanNotes[ch] - 1;

    stampCount++;
    chanStamp[ch] = stampCount;
}

void checkMidiConfig()
{
    //0 = single channel, 1 = MPE lower zone, 2 = MPE upper zone
    int zone = mpeMode != 0 ? (mpeUpperZone != 0 ? 2 : 1) : 0;
    int bend = getLocalConfig(configItemId_pbrange);

    //Notes started under the old settings would otherwise hang or land on the wrong channels
    if (zone != lastZone || mpeMembers != lastMembers || midiChan != lastChan)
    {
        for (int i = 0; i < maxKeys; i++)
        {
            if (keyCols[i][7])
            {
                stopNote(i, 0);
                sendBend(keyCols[i][8], 8192);
            }

            keyCols[i][4] = false;
        }

        cPB = 0;

        //0 member channels tells the receiver the old zone is gone
        if (lastZone > 0 && zone != lastZone)
            sendRPN(lastZone == 2 ? 15 : 0, 6, 0);

        lastZone = zone;
        lastMembers = mpeMembers;
        lastChan = midiChan;
        nextChan = 0;
        mcmStep = 0;
    }

    //Announce again when the bend range changes
    if (bend != lastBend)
        mcmStep = 0;

    lastBend = bend;

    //...or when a host connects, ignoring dropouts under half a second so a flickering link can't restart it every frame
    if (!isConnectedToHost())
    {
        if (hostOffFrames < 12)
            hostOffFrames++;
    }
    else
    {
        if (hostOffFrames >= 12)
            mcmStep = 0;

        hostOffFrames = 0;
    }

    if (zone == 0)
        mcmStep = -1;
    else if (mcmStep >= 0)
    {
        //One step per frame (~25 Hz) so announcing all member channels doesn't flood the MIDI link.
        //The MPE Configuration Message resets member bend ranges to 48, so it goes first
        if (mcmStep == 0)
            sendRPN(mpeUpperZone != 0 ? 15 : 0, 6, mpeMembers);
        else
            sendRPN(getMemberChan(mcmStep - 1), 0, bend);

        mcmStep++;

        if (mcmStep > mpeMembers)
            mcmStep = -1;
    }
}


void keyStrike(int index, int u, int vel)
{
    if (toggleVel != 0) vel = fixedVel;

    //A new touch has no pressure yet, which poly aftertouch and pressure colors go by
    keyCols[index][10] = -1;
    setKeyLit(index, 3, vel);

    stopNote(index, 0);
    startNote(index, vel);
}

void keyPress(int index, int at, int vel)
{
    if (keyCols[index][7] == 0)
        return;

    //Column 10 holds the key's latest pressure: poly aftertouch goes out only when it changes, as do pressure colors
    bool changed = keyCols[index][10] != at;
    keyCols[index][10] = at;

    //MPE pressure is per note by way of its own channel
    if(polyAT != 0 && mpeMode == 0)
    {
        if (changed)
            sendAftertouch (keyCols[index][8], keyCols[index][7] - 1, at);
    }
    else
        sendPressure(keyCols[index][8], at);

    if (changed && (bendPressColors & 2))
        cacheLit(index);
}

void keyMove (int index, int pb, int at)
{
    if (keyCols[index][7] == 0)
        return;

    //Column 4 holds the key's latest bend + 1 once it moves, which the pitch bend counter goes by
    bool changed = keyCols[index][4] != pb + 1;

    if (!keyCols[index][4])
        cPB++;

    keyCols[index][4] = pb + 1;

    sendBend(keyCols[index][8], pb);

    if (changed && (bendPressColors & 1))
        cacheLit(index);
}

void keyLift(int index, int u, int vel)
{
    setKeyLit(index, 3, 0);
    if(keyCols[index][4]){keyCols[index][4] = false; cPB--;}

    stopNote(index, vel);

    //Single channel: reset PitchBend if counter is zero
    //MPE: leave it so the release tail keeps its pitch, the channel's next note clears it
    if (mpeMode == 0 && cPB == 0)
        sendBend(midiChan - 1, 8192);
}

void renderOctaveBtns()
{
    int c = keyCols[curOct + 2][2];

    fillPixel (curOct > minOct ? c : 0, 0, 1);
    fillPixel (curOct < maxOct ? c : 0, 1, 1);
}

//Draws the colors worked out when keys light and values load; only keys that are fading blend
void renderKeys()
{
    for (int i = 0; i < maxKeys; i++)
    {
        if (keyCols[i][3] || keyCols[i][11])
        {
            fillPixel(keyCols[i][6], i, 0);
        }
        else if (keyCols[i][5] > 0)
        {
            fillPixel(blendCol(keyCols[i][9], keyCols[i][6], keyCols[i][5]), i, 0);
            keyCols[i][5] = keyCols[i][5] - fadeInc;
        }
        else
        {
            fillPixel(keyCols[i][9], i, 0);
        }
    }
}

void repaint()
{
    if (reportStep >= 0)
        sendReport();

    checkMidiConfig();

    if(toggleCols){

        //Render key colors
        renderKeys();

        //Render Octave Buttons
        renderOctaveBtns();
    }
    else{
        clearDisplay();
    }

}
